bin/
obj/
*.user
.DS_Store
dist/
# build-plugin.ps1 publishes here before assembling dist\; committing it would put the
# whole publish output - exe, DLLs, PDBs - into a public repo on the next `git add -A`.
artifacts/
.superpowers/

# ShotMarker's own web bundle. Kept locally — tools/extract-targetfaces.js reads it to
# regenerate targetfaces.json — but it is ShotMarker's copyrighted code and this repo is
# public, so it must never be committed. Ruling F31.
fixtures/shotmarker/bundle/

# ShotMarker's device software package (server.js, server_shot.js, the web bundle, …).
# Same reasoning as the bundle above: kept locally for reading, never committed. Ruling F31.
SM_software_*.tar

# The bug report written for AMB about the dead velocity-outlier check. It quotes a few
# expressions from ShotMarker's firmware verbatim, so it stays out of a public repo for
# the same reason the sources above do. Ruling F31.
shotmarker-velocity-warning-report.md
