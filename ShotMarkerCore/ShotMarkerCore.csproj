<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShotMarker.Core</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\external\GRT-Reloading-Toolkit\grt-plugins-shared\GrtPluginKit\GrtPluginKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GRT's own shot-group reader. The writer has to ask it two things it cannot answer
         itself: which unit this GRT install reads an unlabelled reference distance and
         shooting distance in, and how many millimetres a MOA subtends. Both live here, and
         a second copy of either is exactly how a group comes to look right and measure
         wrong. It also serves as the round-trip test's independent oracle.

         These files are plain arithmetic in a net8.0-windows project, so linking the two
         (TargetGroup is declared in BallisticXCsv.cs) keeps this plugin and its tests
         buildable on macOS and Linux, which referencing that project would not. Their own
         dependencies - GrtConfig, GrtUnits, GrtLoadDoc, Str - are in GrtPluginKit, which is
         already referenced above. Ruling F2: these two, nothing else. -->
    <Compile Include="..\external\GRT-Reloading-Toolkit\GrtReloadingToolkit\Ocw\BallisticXCsv.cs" Link="Grt\Oracle\BallisticXCsv.cs" />
    <Compile Include="..\external\GRT-Reloading-Toolkit\GrtReloadingToolkit\Ocw\GrtShotGroups.cs" Link="Grt\Oracle\GrtShotGroups.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/extract-targetfaces.js from the archived bundle in
         fixtures/shotmarker/bundle. Committed so a build needs no Node. -->
    <EmbeddedResource Include="Faces\targetfaces.json" LogicalName="ShotMarker.Core.Faces.targetfaces.json" />
  </ItemGroup>

</Project>
