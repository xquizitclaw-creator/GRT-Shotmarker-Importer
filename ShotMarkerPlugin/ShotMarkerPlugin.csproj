<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net8.0 since 0.2.0: the window is Avalonia, so one build of the UI runs on Windows
         and macOS, and the project compiles on any SDK — no Windows Desktop targeting pack. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShotMarker.Plugin</RootNamespace>
    <!-- GRT's manifest names this exe (launch-windows / launch-macos); it must not change. -->
    <AssemblyName>GRT_ShotMarker</AssemblyName>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same Avalonia as GRTMultiPlatform, the host app. -->
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotMarkerCore\ShotMarkerCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShotMarkerPlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
